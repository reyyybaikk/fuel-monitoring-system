# Contoh file .env untuk pengembangan lokal
# Jangan pernah meng-commit nilai rahasia sebenarnya.

# URL database PostgreSQL (contoh)
# DATABASE_URL=postgresql://user:password@localhost:5432/fuel_monitoring

# URL Redis (contoh)
# REDIS_URL=redis://localhost:6379

# Secret JWT
# JWT_SECRET=rahasia_anda_di_sini

# Origin(s) yang diizinkan untuk CORS (pisahkan dengan koma)
CORS_ORIGIN=https://fuel-monitoring-bbm-frontend-gamma.vercel.app
# PORT=3000
